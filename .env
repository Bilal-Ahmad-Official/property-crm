# Session secret for signing auth tokens (change in production)
AUTH_SECRET=property-crm-dev-secret-change-me

# AI chatbot configuration (OpenAI-compatible API).
# Works with OpenAI, Z.ai GLM, OpenRouter, Groq, Azure OpenAI, Ollama, etc.
# If left empty, the built-in rule-based assistant is used (still queries CRM data).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
